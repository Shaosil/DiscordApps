<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>
    </SiteUrlToLaunchAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>69921e3b-cd39-47f1-9b2b-372e71b9ec57</ProjectGuid>
    <SelfContained>false</SelfContained>
    <MSDeployServiceURL>localhost</MSDeployServiceURL>
    <DeployIisAppPath>shaosilbot.ddnsfree.com</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>false</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>InProc</MSDeployPublishMethod>
    <EnableMSDeployBackup>false</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <UserName />
    <_SavePWD>false</_SavePWD>
    <_TargetId>IISWebDeploy</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <Target Name="StopServer" BeforeTargets="BeforePublish">
    <Message Text="Inside the StopServer/BeforePublish Target" Importance="high" />
    <Exec Command="appcmd stop site &quot;$(DeployIisAppPath)&quot;" />
  </Target>
  <Target Name="StartAndPingServer" AfterTargets="AfterPublish">
    <Message Text="Inside the StartAndPingServer/AfterPublish Target" Importance="high" />
    <Exec Command="appcmd start site &quot;$(DeployIisAppPath)&quot;" />
    <Exec Command="curl https://$(DeployIisAppPath)/ -m 15" />
  </Target>
</Project>